# --- Required -------------------------------------------------------------

# The bearer token your MCP client sends to reach this server. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_AUTH_TOKEN=

# --- Piazza ---------------------------------------------------------------
# Your UWaterloo email and your Piazza password. The server signs in on its own
# and re-signs in whenever the Piazza session expires.

PIAZZA_EMAIL=
PIAZZA_PASSWORD=

# --- Learn ----------------------------------------------------------------
# Your WatIAM username and password. Used only to pass UWaterloo sign-in and Duo,
# and never accepted as an MCP tool argument.
#
# A bare username has @uwaterloo.ca appended, so "jsmith" and "jsmith@uwaterloo.ca"
# are equivalent here. This is the WatIAM login, which is not always the same as an
# @uwaterloo.ca email alias.

UWATERLOO_USERNAME=
UWATERLOO_PASSWORD=

# Optional. A Brightspace session cookie, which /setup can also establish for you
# by signing in. Set it here to start with a working session, or after signing in
# once if you want the session to survive restarts. It expires after 180 idle
# minutes either way.
D2L_COOKIE=

# --- Optional -------------------------------------------------------------

D2L_HOST=https://learn.uwaterloo.ca
PORT=8787
# Most hosts set PORT themselves; use 0.0.0.0 if yours does not bind for you.
HOST=127.0.0.1
MCP_PUBLIC_URL=
MCP_ALLOWED_ORIGINS=
MCP_ALLOWED_HOSTS=
